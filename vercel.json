{
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/api/fitness/:path*",
      "destination": "/api/personalfit?route=:path*"
    },
    {
      "source": "/personalfitgoals/privacy",
      "destination": "/personalfitgoals-privacy.html"
    },
    {
      "source": "/personalfitgoals",
      "destination": "/personalfitgoals.html"
    },
    {
      "source": "/personalfitgoals/",
      "destination": "/personalfitgoals.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/personalfit.js": {
      "maxDuration": 120,
      "includeFiles": "lib/fitness/schema.sql"
    }
  }
}
